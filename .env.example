SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=dovideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
# 部分站点（如 B 站）缺少登录态会返回 HTTP 412，需要提供 cookie 才能下载在线视频链接。
# 二者互斥，YTDLP_COOKIES 优先；留空则不带 cookie（仅支持无需登录的站点）。
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
FFMPEG_DIR=
OCR_COMMAND=tesseract
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
# Default homepage is My Courses. Set false and restart Vite/rebuild for the legacy UI.
VITE_COURSE_WORKBENCH_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Python parsing service (PARSED is not indexed/READY).
LEARNING_PARSING_ENABLED=false
LEARNING_PYTHON_URL=http://127.0.0.1:8091
LEARNING_SERVICE_TOKEN=
# Same media_db, separate ai_* tables. URL-encode credentials. Docker uses mysql:3306.
LEARNING_DATABASE_URL=
LEARNING_JAVA_URL=http://127.0.0.1:9090
LEARNING_MINIO_ENDPOINT=127.0.0.1:9000
LEARNING_MINIO_ACCESS_KEY=
LEARNING_MINIO_SECRET_KEY=
LEARNING_MINIO_BUCKET=media
LEARNING_MINIO_SECURE=false
DOCLING_ARTIFACTS_PATH=
# Local knowledge embedding (the worker is offline-only and never downloads models)
LEARNING_EMBEDDING_PROVIDER=local_bge_m3
LEARNING_EMBEDDING_MODEL_PATH=.learning-models/bge-m3
LEARNING_EMBEDDING_MODEL_REVISION=pinned-local-revision
LEARNING_EMBEDDING_DIMENSION=1024
LEARNING_EMBEDDING_BATCH_SIZE=16
LEARNING_EMBEDDING_DEVICE=cpu
LEARNING_QDRANT_URL=http://qdrant:6333
LEARNING_QDRANT_COLLECTION=course_knowledge_bge_m3_d1024_v1
LEARNING_QDRANT_API_KEY=

# Learning Agent LLM (OpenAI-compatible). Keep secrets only in the ignored .env.
# The application never supplies a default provider or model.
LEARNING_LLM_BASE_URL=
LEARNING_LLM_API_KEY=
LEARNING_LLM_MODEL=
LEARNING_LLM_TIMEOUT_SECONDS=45
LEARNING_LLM_MAX_INPUT_TOKENS=24000
LEARNING_LLM_MAX_OUTPUT_TOKENS=1600
LEARNING_LLM_TEMPERATURE=0.2
# Optional provider feature. DeepSeek defaults to thinking; disable it for the
# bounded structured-output Agent loop. Leave empty for providers without it.
LEARNING_LLM_THINKING=
