# Copy to .env and load it into the shell before running the Gateway and Workers.
# Use the same PostgreSQL password here and in the database URL (URL-encode it there).
DOVIDEO_POSTGRES_PASSWORD=CHANGE_ME
DOVIDEO_DATABASE_URL=postgresql+psycopg://dovideo:CHANGE_ME@127.0.0.1:5433/dovideo_v2
DOVIDEO_MINIO_ENDPOINT=http://127.0.0.1:9100
DOVIDEO_MINIO_ACCESS_KEY=dovideo
DOVIDEO_MINIO_SECRET_KEY=CHANGE_ME_LONG_SECRET
DOVIDEO_QDRANT_URL=http://127.0.0.1:6433
DOVIDEO_QDRANT_API_KEY=CHANGE_ME_LONG_SECRET
DOVIDEO_MINIO_BUCKET=dovideo-v2
DOVIDEO_SESSION_HOURS=24
DOVIDEO_UPLOAD_EXPIRY_MINUTES=30
# Optional exact HTTPS hostname allowlist for direct-file URL import; empty disables import.
DOVIDEO_IMPORT_HOSTS=
# Local, offline BGE-M3; runtime.local.json can persist these settings.
DOVIDEO_EMBEDDING_MODEL_PATH=.learning-models/bge-m3
DOVIDEO_EMBEDDING_DEVICE=cpu
# Defaults to .learning-models/bge-m3.revision.txt if omitted.
DOVIDEO_EMBEDDING_REVISION=

# OpenAI-compatible model for the Agent Worker.
DOVIDEO_CHAT_BASE_URL=
DOVIDEO_CHAT_API_KEY=
DOVIDEO_CHAT_MODEL=

# Local Vite development and preview proxy.
VITE_V2_PROXY_TARGET=http://127.0.0.1:8092
