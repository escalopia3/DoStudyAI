{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-run-result.schema.json",
  "title": "LearningAgentRunResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "status", "answer", "knowledgeSnapshotId", "citations", "usage"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "runId": {"type": "string"},
    "status": {"enum": ["COMPLETED", "FAILED", "CANCELLED", "TIMED_OUT", "BUDGET_EXCEEDED"]},
    "answer": {"type": "string"},
    "knowledgeSnapshotId": {"type": "string"},
    "citations": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "usage": {"type": "object"},
    "errorCode": {"type": ["string", "null"]}
  }
}
